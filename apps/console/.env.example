# MOC Console configuration. VITE_* values are inlined into the public JS
# bundle, so nothing secret belongs here. MOC_API_PROXY_TARGET is used only by
# the dev server. Server secrets live in apps/api/.env.example.

# Local development only: Vite forwards /api requests to this server.
# Defaults to http://localhost:3001 (`bun run dev:api`). Set to the deployed
# API origin to develop against the existing API instead.
MOC_API_PROXY_TARGET=http://localhost:3001

# Public origin of the standalone broadcast player. The console uses this to
# build copyable player links (for example, http://localhost:5174 locally).
VITE_BROADCAST_APP_URL=

# Google OAuth — client ID and redirect URI are referenced in the browser to
# build the consent URL. The client secret is server-side only and lives in
# the API app.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=

# Zoom OAuth — same rule: client_id / redirect_uri are browser-side; the
# client secret lives in the API app. The redirect URI must be an HTTPS FQDN
# registered in Zoom Marketplace and must match the API's ZOOM_REDIRECT_URI.
VITE_ZOOM_CLIENT_ID=
VITE_ZOOM_REDIRECT_URI=

VITE_TELEGRAM_BOT_USERNAME=

# MOC Console — browser-only configuration. Every value here is inlined into
# the public JS bundle, so nothing secret belongs in this file. All server-side
# secrets live in apps/api/.env.example.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Origin of the MOC API app (e.g. https://api.psape.co.za). Every /api/* call
# is sent here. Leave blank to keep calls relative to the console's own origin
# — useful only if you front the API with a same-origin proxy.
# For local dev: run `bun run dev:api` and set this to http://localhost:3001.
VITE_API_BASE_URL=

# Google OAuth — client ID and redirect URI are referenced in the browser to
# build the consent URL. The client secret is server-side only and lives in
# the API app.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=

# Zoom OAuth — same rule: client_id / redirect_uri are browser-side; the
# client secret lives in the API app.
VITE_ZOOM_CLIENT_ID=
VITE_ZOOM_REDIRECT_URI=

VITE_TELEGRAM_BOT_USERNAME=

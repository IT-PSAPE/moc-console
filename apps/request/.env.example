# MOC Request — browser-only configuration. Every value here is inlined into
# the public JS bundle. This app has no server-side code any more: the notify
# endpoints moved to the MOC API app, so MOC_CONSOLE_BASE_URL and
# NOTIFICATIONS_INGEST_SECRET are no longer needed here.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
VITE_WORKSPACE_ID=

# Origin of the MOC API app (e.g. https://api.psape.co.zw). Submission
# notifications POST to <this>/api/notify/*. Leave blank to keep calls
# relative to this app's own origin.
# For local dev: run `bun run dev:api` and set this to http://localhost:3001.
VITE_API_BASE_URL=

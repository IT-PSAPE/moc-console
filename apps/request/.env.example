# MOC Request — browser-only configuration. Every value here is inlined into
# the public JS bundle. This app has no server-side code any more: the notify
# endpoints moved to the MOC API app, so MOC_CONSOLE_BASE_URL and
# NOTIFICATIONS_INGEST_SECRET are no longer needed here.

VITE_WORKSPACE_ID=

# Local development only: Vite forwards /api requests to this server.
# Defaults to http://localhost:3001 (`bun run dev:api`).
MOC_API_PROXY_TARGET=http://localhost:3001

# MOC API — every server-side secret for the platform lives here and nowhere
# else. Neither frontend needs a server secret any more.
#
# Deployed as its own Vercel project (api.psape.co.za). Nothing in this file is
# exposed to either frontend bundle. The historical Supabase URL variable keeps
# its VITE_ prefix for compatibility, but this API app does not bundle it.

# ─── Supabase ─────────────────────────────────────────────
# VITE_SUPABASE_URL keeps its historical name (getSupabaseAdmin reads it) even
# though nothing bundles it here. SUPABASE_SECRET_KEY is the service-role key —
# it bypasses RLS.
VITE_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated exact origins allowed to call this API from a browser: the
# console and the request PWA. No trailing slashes, no wildcards. Unset means
# no browser origin is allowed (fail closed); server-to-server callers such as
# the Telegram webhook and Vercel Cron send no Origin and are unaffected.
# e.g. https://console.psape.co.za,https://request.psape.co.za,http://localhost:5173
ALLOWED_ORIGINS=

# ─── Console deep links ───────────────────────────────────
# Public origin of MOC Console, used to build "View request" / "View booking"
# links inside outbound Telegram messages (e.g. https://console.psape.co.za).
# This app's own VERCEL_URL is NOT a fallback — it points at the API, and a
# link built from it would 404. Unset means link-bearing notifications are
# skipped rather than sent with a broken link.
CONSOLE_BASE_URL=

# ─── Google / YouTube OAuth ───────────────────────────────
# The client ID is public (the console ships it as VITE_GOOGLE_CLIENT_ID to
# build the consent URL) but this app needs its own copy: Google's token
# endpoint requires the id alongside the secret on every code exchange AND on
# every refresh. Unset means each stored access token works until it expires
# and then every YouTube call fails, because the refresh cannot be signed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Zoom ─────────────────────────────────────────────────
# Same as Google above: the id is public, but refresh and exchange both need it
# server-side. Unset breaks Zoom one token lifetime after connecting.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Exact HTTPS callback registered in Zoom Marketplace. It must match the
# console's VITE_ZOOM_REDIRECT_URI byte-for-byte.
ZOOM_REDIRECT_URI=
# Zoom Marketplace Event Subscription secret token. Used only to validate
# x-zm-signature and URL validation challenges; never expose it to a browser.
ZOOM_SECRET_TOKEN=

# ─── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ─── Inbound signing ──────────────────────────────────────
# Shared HMAC secret for EXTERNAL senders posting to /api/notifications/requests
# and /api/notifications/bookings. See README for the signed-ingest protocol.
# MOC Request no longer uses this — it calls /api/notify/* in this same app,
# which dispatches directly.
NOTIFICATIONS_INGEST_SECRET=

# ─── Cron ─────────────────────────────────────────────────
# Guards /api/cron/* (weekly archive + daily stale-item sweep). Vercel sends it
# as `Authorization: Bearer <CRON_SECRET>` on each scheduled run. Unset means
# the cron endpoints reject everything and the jobs never run.
CRON_SECRET=

# MoC API: server-only values; never put these into VITE_* variables.
# Dedicated pooled connection limited to runtime role memberships.
DATABASE_URL=
# Deployed MoC auth Function URL, not the managed Neon Auth endpoint.
NEON_AUTH_FUNCTION_URL=
# Generate with openssl rand -hex 32; match the corresponding auth Function.
MOC_AUTH_SERVICE_SECRET=
# Exact accepted origins, comma separated; local: http://localhost:5173.
MOC_AUTH_TRUSTED_ORIGINS=
# Canonical Console origin; local: http://localhost:5173.
MOC_CONSOLE_ORIGIN=
# Neon Object Storage S3-compatible credentials; private buckets.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated exact origins allowed to call this API from a browser: the
# console and the request PWA. No trailing slashes, no wildcards. Unset means
# no browser origin is allowed (fail closed); server-to-server callers such as
# the Telegram webhook and Neon scheduled workers send no Origin and are unaffected.
# Local development needs the exact Console and Request origins. If Console
# runs on an alternate port (e.g. 5177), include http://localhost:5177 here too.
# MOC_AUTH_TRUSTED_ORIGINS controls login separately; setting it alone is insufficient.
# e.g. https://console.psape.co.za,https://request.psape.co.za,http://localhost:5173,http://localhost:5176
ALLOWED_ORIGINS=

# ─── Console deep links ───────────────────────────────────
# Public origin of MOC Console, used to build "View request" / "View booking"
# links inside outbound Telegram messages (e.g. https://console.psape.co.za).
# This app's own VERCEL_URL is NOT a fallback — it points at the API, and a
# link built from it would 404. Unset means link-bearing notifications are
# skipped rather than sent with a broken link.
CONSOLE_BASE_URL=

# Console Web Push public key, matching the Neon consolepush Function.
# Keep the private key and contact subject in the Neon worker environment.
# Generate with apps/api/scripts/generate-web-push-keys.ts.
WEB_PUSH_VAPID_PUBLIC_KEY=

# ─── Google / YouTube OAuth ───────────────────────────────
# The client ID is public (the console ships it as VITE_GOOGLE_CLIENT_ID to
# build the consent URL) but this app needs its own copy: Google's token
# endpoint requires the id alongside the secret on every code exchange AND on
# every refresh. Unset means each stored access token works until it expires
# and then every YouTube call fails, because the refresh cannot be signed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Zoom ─────────────────────────────────────────────────
# Same as Google above: the id is public, but refresh and exchange both need it
# server-side. Unset breaks Zoom one token lifetime after connecting.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Exact HTTPS callback registered in Zoom Marketplace. It must match the
# console's VITE_ZOOM_REDIRECT_URI byte-for-byte.
ZOOM_REDIRECT_URI=
# Zoom Marketplace Event Subscription secret token. Used only to validate
# x-zm-signature and URL validation challenges; never expose it to a browser.
ZOOM_SECRET_TOKEN=

# ─── Telegram ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot username without the leading "@", used to build Mini App deep links (t.me/<username>?startapp=...).
TELEGRAM_BOT_USERNAME=

# ─── Inbound signing ──────────────────────────────────────
# Shared HMAC secret for EXTERNAL senders posting to /api/notifications/requests
# and /api/notifications/bookings. See README for the signed-ingest protocol.
# MOC Request no longer uses this — it calls /api/notify/* in this same app,
# which dispatches directly.
NOTIFICATIONS_INGEST_SECRET=

# Server-only invitation email delivery (used by users.invite/resendInvitation).
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=

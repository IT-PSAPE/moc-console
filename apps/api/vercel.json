{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "crons": [
    { "path": "/api/cron/weekly-archive", "schedule": "0 0 * * 1" },
    { "path": "/api/cron/notification-deliveries", "schedule": "0 1 * * *" },
    { "path": "/api/cron/stream-sync", "schedule": "0 9 * * *" },
    {"path": "/api/cron/scheduled-messages", "schedule": "0 0 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 1 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 2 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 3 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 4 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 5 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 6 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 7 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 8 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 9 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 10 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 11 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 12 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 13 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 14 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 15 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 16 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 17 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 18 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 19 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 20 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 21 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 22 * * *"},
    {"path": "/api/cron/scheduled-messages", "schedule": "0 23 * * *"}
  ],
  "functions": {
    "api/cron/*.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/public/submissions", "destination": "/api/notify/public-submissions" },
    { "source": "/api/youtube/v3/(.*)", "destination": "/api/youtube/v3/_proxy?rewrittenPath=$1" },
    { "source": "/api/zoom/v2/(.*)", "destination": "/api/zoom/v2/_proxy?rewrittenPath=$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0, must-revalidate" },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Vercel-CDN-Cache-Control", "value": "no-store" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" }
      ]
    }
  ]
}

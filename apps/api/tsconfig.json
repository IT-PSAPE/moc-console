{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* Vercel runs these as ESM Node functions and compiles each one itself;
       we only typecheck. nodenext keeps the ".js" import specifiers the
       runtime needs resolvable against their ".ts" sources. */
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["api", "server"],

  /* Build mode compiles this first, which puts @moc/notifications' emitted
     JavaScript on disk before the functions that import it are bundled. The
     API build uses --force because Vercel can restore tsbuildinfo without the
     referenced package's ignored dist directory. */
  "references": [{ "path": "../../packages/notifications" }]
}

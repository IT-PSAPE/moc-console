{
  "name": "@moc/notifications",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "default": "./src/index.ts"
    },
    "./*": {
      "node": { "types": "./dist/*.d.ts", "default": "./dist/*.js" },
      "default": "./src/*.ts"
    }
  }
}

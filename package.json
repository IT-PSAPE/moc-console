{
  "name": "moc-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:console": "npm run dev --workspace apps/console",
    "dev:request": "npm run dev --workspace apps/request",
    "dev:broadcast": "npm run dev --workspace apps/broadcast",
    "dev:api": "npm run --workspace apps/api build",
    "build:console": "npm run build --workspace apps/console",
    "build:request": "npm run build --workspace apps/request",
    "build:broadcast": "npm run build --workspace apps/broadcast",
    "build:api": "npm run build --workspace apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test:api": "npm run test --workspace apps/api"
  }
}

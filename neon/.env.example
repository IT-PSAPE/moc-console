# Neon deploy/validation configuration, server only.
NEON_PROJECT_ID=blue-wind-16947728
# Inject branch-scoped database/storage credentials through Neon.
# Generate independently from the service secret.
BETTER_AUTH_SECRET=
# Generate with openssl rand -hex 32; match the corresponding API environment.
MOC_AUTH_SERVICE_SECRET=
MOC_AUTH_TRUSTED_ORIGINS=
# Both must be the same public Console origin (never the API/Function URL).
# Local authdev: http://localhost:5173. Production: https://console.psape.co.za.
MOC_AUTH_PUBLIC_BASE_URL=
MOC_CONSOLE_ORIGIN=
# Leave blank to derive cookie security from the canonical URL's HTTPS scheme.
MOC_AUTH_COOKIE_SECURE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Keep false until the runtime target and operational gates pass.
MOC_ENABLE_PRODUCTION_JOBS=false
MOC_NEON_BRANCH=production
CONSOLE_BASE_URL=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Local migration tools only; these are not deployed into Neon Functions.
# Migration-owner target connection, distinct from the API pooled runtime URL.
NEON_DATABASE_URL=
# Optional alternative to the connected SQL + Data API snapshot export.
# Legacy Supabase PostgreSQL direct/session connection, with read access to
# public, private, auth.users and storage metadata. Never use a VITE_* key.
LEGACY_SOURCE_DATABASE_URL=
# Source HTTPS APIs for domain snapshots and Storage object downloads.
SUPABASE_URL=
# Current server-side secret key (sb_secret_...), not the legacy service_role JWT.
SUPABASE_SECRET_KEY=
# Object import credentials for the selected Frankfurt branch.
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_REGION=auto

{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext", "moduleResolution": "NodeNext", "types": ["node"],
    "noEmit": true, "strict": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "verbatimModuleSyntax": true
  },
  "include": ["../neon.ts", "**/*.ts"]
}
